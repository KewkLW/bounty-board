{
  "port": 3777,
  "host": "0.0.0.0",
  "allow_cidrs": ["127.0.0.0/8", "::1/128", "100.64.0.0/10", "fd7a:115c:a1e0::/48"],
  "db_path": "data/bounty-board.db",
  "logs_dir": "logs",
  "concurrency_cap": 3,
  "tick_seconds": 5,
  "watchdog": { "stall_minutes": 30, "check_seconds": 30, "kill_grace_seconds": 15 },
  "retry": {
    "max_attempts": 4,
    "escalate_after_failures": 2,
    "escalate_model": { "haiku": "sonnet", "sonnet": "opus" }
  },
  "leases": { "default_ttl_minutes": 45 },
  "merge_check_seconds": 60,
  "verify_concurrency": 1,
  "reviewer": {
    "runner": "codex",
    "model": null,
    "timeout_minutes": 25,
    "max_diff_chars": 160000,
    "max_errors": 3
  },
  "runners": {
    "claude": {
      "bin": "claude",
      "allowed_tools": "Bash,Read,Grep,Glob,Edit,Write,MultiEdit,TodoWrite,WebSearch,WebFetch"
    },
    "codex": {
      "bin": "codex",
      "args": ["--dangerously-bypass-approvals-and-sandbox"]
    }
  },
  "slots": [
    { "id": "opus-1", "runner": "claude", "model": "opus", "effort": "high" },
    { "id": "opus-2", "runner": "claude", "model": "opus", "effort": "high" },
    { "id": "opus-3", "runner": "claude", "model": "opus", "effort": "high" },
    { "id": "opus-4", "runner": "claude", "model": "opus", "effort": "high" },
    { "id": "sonnet-tester", "runner": "claude", "model": "sonnet", "effort": "low" },
    { "id": "codex-1", "runner": "codex", "model": null, "effort": "high" },
    { "id": "codex-2", "runner": "codex", "model": null, "effort": "high" }
  ]
}
