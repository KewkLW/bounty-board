#!/usr/bin/env node
// bounty: the Bounty Board CLI for workers and the orchestrator. Talks to the server
// ($BOUNTY_URL, default http://127.0.0.1:3777). Workers are identified by BOUNTY_ID and
// BOUNTY_SLOT (the dispatcher sets both).
const fs = require('fs');

const URL_BASE = (process.env.BOUNTY_URL || 'http://127.0.0.1:3777').replace(/\/$/, '');
const SLOT = process.env.BOUNTY_SLOT || '';
const ACTOR = SLOT || process.env.BOUNTY_ACTOR || 'orchestrator';
const ENV_ID = process.env.BOUNTY_ID || '';

const HELP = `bounty: the Bounty Board CLI  (server ${URL_BASE}, actor ${ACTOR})

Orchestrator
  bounty add "<title>" [--desc TEXT | --brief FILE.md] [--criteria "..."]... [--type task|bug|test|research|art|docs]
             [--tier S|A|B|C] [--priority critical|high|normal|low] [--project ID] [--slot SLOT] [--depends 3,4] [--ready]
                                   (no --project: the configured default_project, or the only non-legacy project)
  bounty add --file TASK.md        (# Title, optional key: value header lines, "## Acceptance criteria" with - [ ] items)
  bounty list [--status s1,s2] [--project P] [--slot S|none] [--type T] [--all] [--json]
  bounty show [ID] [--json]        bounty log ID [--raw]
  bounty edit ID [--title T] [--desc TEXT|--brief FILE] [--criteria "..."]... [--tier] [--priority] [--type] [--project P] [--depends 3,4] [--file TASK.md]
  bounty note ID "text"            tell the live worker (and every later attempt) something new
  bounty inbox ID --peek           the notes that worker has not read yet (without marking them read)
  bounty replies [--all] [--peek] [--json]
                                   messages from the human (the hub's reply box): bounty, project, time, text.
                                   Prints the unread ones and marks them read; --all shows read ones too (and
                                   marks the unread among them read); --peek marks nothing read
  bounty assign ID SLOT|none       bounty ready ID...        bounty backlog ID
  bounty approve ID ["notes"]      bounty reject ID "notes"  bounty done ID   (only if the commits are on main)
  bounty fail ID "reason"          bounty kill ID ["reason"]
  bounty close-merged ID --commit SHA [--commit SHA]... ["evidence"]
                                   done for work merged outside the board (external): each commit must be on main;
                                   refused while a board worker is live. Records commits + evidence; loot only to
                                   a slot whose board attempt submitted those commits (external work credits nobody).
  bounty pause | resume            bounty status             bounty import <source>
  bounty live [--json] [--watch [SEC]]  what every slot is doing now: bounty, pipeline stage, verify/CI stage,
                                   last actions, progress note, lock waits/holders, tester, queue, last 24 h
  bounty leaderboard [--json]      the slots' loot, dones, failures, streak and $ cost (verified work only)
  bounty project list | bounty project add ID --repo PATH [--main main] [--wt-cmd CMD] [--wt-path TPL] [--verify CMD]
Workers (BOUNTY_ID / BOUNTY_SLOT from the environment)
  bounty start                     bounty progress "note" [--check N]...     (both print unread notes)
  bounty inbox                     unread orchestrator notes and messages from the human; marks them read. Check it often.
  bounty block "reason"            bounty split "<title>" [--desc TEXT] [--criteria "..."]...
  bounty submit [--branch B] [--no-wait]
  bounty next                      bounty lease gpu [--ttl MIN] [--no-wait]    bounty release gpu
`;

function parse(argv) {
  const pos = [], opt = {};
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a.startsWith('--')) {
      const k = a.slice(2);
      const nxt = argv[i + 1];
      const flag = ['ready', 'all', 'json', 'raw', 'no-wait', 'wait', 'force', 'help', 'peek'].includes(k);
      const v = flag || nxt === undefined || nxt.startsWith('--') ? true : (i++, nxt);
      if (opt[k] === undefined) opt[k] = v; else opt[k] = [].concat(opt[k], v);
    } else pos.push(a);
  }
  return { pos, opt };
}
const list = v => (v === undefined ? [] : [].concat(v));

async function api(method, p, body) {
  let res;
  try {
    res = await fetch(URL_BASE + '/api' + p, {
      method, headers: { 'content-type': 'application/json', 'x-bounty-actor': ACTOR, 'x-board-request': '1' },
      body: body === undefined ? undefined : JSON.stringify(body),
    });
  } catch (e) {
    die(`cannot reach the board at ${URL_BASE} (${e.cause?.code || e.message})`);
  }
  const text = await res.text();
  let data; try { data = JSON.parse(text); } catch { data = text; }
  if (!res.ok) die(`${res.status}: ${data && data.error ? data.error : text}`);
  return data;
}
function die(msg) { console.error(`bounty: ${msg}`); process.exit(1); }
function idOf(pos, i = 0) {
  const id = pos[i] || ENV_ID;
  if (!id || !/^\d+$/.test(String(id))) die('which bounty? pass an ID or set BOUNTY_ID');
  return Number(id);
}
// Orchestrator notes (kind 'message') and messages from the human (kind 'human'), each under its own header.
function printNotes(notes, { header = true } = {}) {
  if (!notes || !notes.length) return false;
  const line = n => console.log(`[${String(n.at).slice(0, 16).replace('T', ' ')} ${n.actor || 'orchestrator'}] ${n.note}`);
  const orch = notes.filter(n => n.kind !== 'human'), human = notes.filter(n => n.kind === 'human');
  if (!header) { notes.forEach(n => (n.kind === 'human' ? console.log(`[${String(n.at).slice(0, 16).replace('T', ' ')} FROM THE HUMAN ${humanName(n)}] ${n.note}`) : line(n))); return true; }
  if (orch.length) {
    console.log(`\n=== ${orch.length} NEW NOTE${orch.length > 1 ? 'S' : ''} FROM THE ORCHESTRATOR (act on ${orch.length > 1 ? 'these' : 'this'} before you continue; ${orch.length > 1 ? 'they win' : 'it wins'} over the brief) ===`);
    orch.forEach(line);
    console.log('=== end of notes ===');
  }
  if (human.length) {
    console.log(`\n=== ${human.length} NEW MESSAGE${human.length > 1 ? 'S' : ''} FROM THE HUMAN (the person running this board wrote ${human.length > 1 ? 'these' : 'this'} themselves; act on ${human.length > 1 ? 'them' : 'it'} before you continue) ===`);
    for (const n of human) console.log(`[${String(n.at).slice(0, 16).replace('T', ' ')} ${humanName(n)}] ${n.note}`);
    console.log('=== end of messages ===');
  }
  return true;
}
const humanName = n => String(n.actor || n.from || '').replace(/^human:/, '') || 'human';
function fmtReply(n) {
  return `#${n.bounty_id} ${n.project || '-'}  ${String(n.created_at).slice(0, 16).replace('T', ' ')}  from ${n.from}${n.read ? '' : '  (new)'}  ${n.title}\n    ${String(n.text).replace(/\n/g, '\n    ')}`;
}
const sleep = ms => new Promise(r => setTimeout(r, ms));

function fmtRow(b) {
  const slot = b.assignee_slot || '-';
  return `#${String(b.id).padEnd(4)} ${b.status.padEnd(11)} ${b.tier} ${b.priority.padEnd(8)} ${b.type.padEnd(8)} ${(b.project_id || '-').padEnd(11)} ${slot.padEnd(13)} ${b.title}`;
}

function show(b) {
  const L = [];
  L.push(`#${b.id} ${b.ticket_id}  [${b.status}]  ${b.title}`);
  L.push(`project ${b.project_id || '-'} | type ${b.type} | tier ${b.tier} (${b.tier_name}) | priority ${b.priority} | slot ${b.assignee_slot || '-'}${b.external_owner ? ' | external: ' + b.external_owner : ''}`);
  if (b.blocked_reason) L.push(`BLOCKED: ${b.blocked_reason}`);
  if (b.branch || b.worktree) L.push(`branch ${b.branch || '-'} | worktree ${b.worktree || '-'}`);
  if (b.parent_id) L.push(`parent #${b.parent_id}`);
  if ((b.depends_on || []).length) L.push(`depends on ${b.depends_on.map(d => '#' + d).join(', ')}`);
  if ((b.children || []).length) L.push(`children: ${b.children.map(c => `#${c.id} [${c.status}] ${c.title}`).join('; ')}`);
  L.push(`attempts ${b.attempts} | failures ${b.failures} | cost $${(b.cost_usd || 0).toFixed(4)} | tokens in ${b.tokens_in} out ${b.tokens_out} | worker ${b.worker_alive ? 'LIVE' : 'none'}`);
  if (b.ci_status) L.push(`verify: ${b.ci_status} ${b.ci_log ? '(' + b.ci_log + ')' : ''}`);
  if ((b.commits || []).length) L.push(`commits: ${b.commits.map(c => c.slice(0, 10)).join(' ')}`);
  if (b.description) L.push('', b.description);
  if ((b.criteria || []).length) {
    L.push('', 'Acceptance criteria:');
    b.criteria.forEach((c, i) => L.push(`  ${i + 1}. [${c.done ? 'x' : ' '}] ${c.text}${c.note ? `  (${c.note})` : ''}`));
  }
  if (b.review_notes) L.push('', 'Review:', b.review_notes);
  const human = (b.events || []).filter(e => e.kind === 'human');
  if (human.length) {
    L.push('', 'Messages from the human:');
    for (const e of human) L.push(`  ${e.at.slice(0, 16).replace('T', ' ')} ${humanName(e)}${e.orch_read_at ? '' : ' (unread by the orchestrator)'}: ${e.note}`);
  }
  const atts = b.attempts_detail || [];
  if (atts.length) {
    L.push('', 'Attempts:');
    for (const a of atts) L.push(`  ${a.id} ${a.kind} ${a.slot} ${a.model || ''} pid ${a.pid} ${a.started_at} -> ${a.ended_at || 'running'} exit ${a.exit_code ?? '-'} $${a.cost_usd ?? 'n/a'} ${a.outcome || ''}\n     log: ${URL_BASE}/api/attempts/${a.id}/log   (${a.log_path})`);
  }
  L.push('', 'History:');
  for (const e of (b.events || []).slice(-25)) L.push(`  ${e.at.slice(0, 19)} ${String(e.actor || '').padEnd(12)} ${e.kind}${e.to_status ? ` ${e.from_status || ''}->${e.to_status}` : ''} ${e.note ? String(e.note).split('\n')[0].slice(0, 220) : ''}`);
  return L.join('\n');
}

function parseTaskFile(file) {
  const text = fs.readFileSync(file, 'utf8');
  const lines = text.split('\n');
  const out = { criteria: [] };
  let i = 0;
  if (lines[0] && lines[0].trim() === '---') {
    for (i = 1; i < lines.length && lines[i].trim() !== '---'; i++) {
      const m = lines[i].match(/^(\w[\w_-]*):\s*(.*)$/);
      if (m) out[m[1].toLowerCase()] = m[2].trim();
    }
    i++;
  }
  const desc = [];
  let inCrit = false;
  for (; i < lines.length; i++) {
    const l = lines[i];
    const h1 = l.match(/^#\s+(.+)/);
    if (h1 && !out.title) { out.title = h1[1].trim(); continue; }
    if (/^##+\s+acceptance criteria/i.test(l)) { inCrit = true; continue; }
    if (inCrit && /^##?\s/.test(l)) inCrit = false;
    if (inCrit) {
      const m = l.match(/^\s*[-*]\s*(\[[ xX]\]\s*)?(.+)/);
      if (m) out.criteria.push(m[2].trim());
      continue;
    }
    const kv = !out.title ? null : l.match(/^(tier|priority|type|project|slot|depends|depends_on):\s*(\S.*)$/i);
    if (kv && desc.every(d => !d.trim())) { out[kv[1].toLowerCase()] = kv[2].trim(); continue; }
    desc.push(l);
  }
  out.description = desc.join('\n').trim();
  return out;
}

async function main() {
  const { pos, opt } = parse(process.argv.slice(2));
  const cmd = pos.shift();
  if (!cmd || cmd === 'help' || opt.help) { console.log(HELP); return; }
  const worker = !!SLOT;
  const orchOnly = ['add', 'edit', 'note', 'replies', 'assign', 'ready', 'backlog', 'approve', 'reject', 'done', 'fail', 'kill', 'close-merged', 'pause', 'resume', 'import'];
  if (worker && orchOnly.includes(cmd)) die(`'${cmd}' is an orchestrator command; you are worker ${SLOT}`);

  switch (cmd) {
    case 'add': {
      let d = {};
      if (opt.file) d = parseTaskFile(opt.file);
      if (pos[0]) d.title = pos[0];
      if (opt.brief) d.description = fs.readFileSync(opt.brief, 'utf8');
      if (opt.desc) d.description = opt.desc;
      if (opt.criteria) d.criteria = list(opt.criteria);
      for (const k of ['type', 'tier', 'priority', 'project']) if (opt[k]) d[k] = opt[k];
      if (opt.slot || d.slot) d.assignee_slot = opt.slot || d.slot;
      const dep = opt.depends || d.depends || d.depends_on;
      if (dep) d.depends_on = String(dep).split(',').map(s => Number(s.replace('#', '').trim())).filter(Boolean);
      if (opt.parent) d.parent_id = Number(opt.parent);
      delete d.slot; delete d.depends;
      if (!d.title) die('add needs a title (or --file with a # Title)');
      const b = await api('POST', '/bounties', d);
      console.log(`added #${b.id} ${b.ticket_id}: ${b.title} [${b.status}] project ${b.project_id}`);
      if (opt.ready) { await api('POST', `/bounties/${b.id}/ready`, {}); console.log(`#${b.id} -> ready`); }
      return;
    }
    case 'list': case 'ls': {
      const q = new URLSearchParams();
      if (opt.status) q.set('status', opt.status);
      else if (!opt.all) q.set('status', 'backlog,ready,in_progress,review,approved,blocked');
      for (const k of ['project', 'slot', 'type', 'tier', 'priority', 'q']) if (opt[k]) q.set(k, opt[k]);
      const rows = await api('GET', `/bounties?${q}`);
      if (opt.json) { console.log(JSON.stringify(rows, null, 2)); return; }
      for (const b of rows) console.log(fmtRow(b));
      console.log(`(${rows.length})`);
      return;
    }
    case 'show': {
      const b = await api('GET', `/bounties/${idOf(pos)}`);
      if (opt.json) { console.log(JSON.stringify(b, null, 2)); return; }
      console.log(show({ ...b, attempts_detail: b.attempts, attempts: b.attempts.filter(a => a.kind === 'worker').length }));
      return;
    }
    case 'log': {
      const b = await api('GET', `/bounties/${idOf(pos)}`);
      const a = [...b.attempts].reverse().find(x => !opt.review || x.kind === 'review');
      const human = (b.events || []).filter(e => e.kind === 'human');
      if (human.length && !opt.raw) {
        console.log(`=== messages from the human on #${b.id} ===`);
        for (const e of human) console.log(`[${e.at.slice(0, 16).replace('T', ' ')} ${humanName(e)}] ${e.note}`);
        console.log('=== end of messages ===\n');
      }
      if (!a) die('no attempts yet');
      const res = await fetch(`${URL_BASE}/api/attempts/${a.id}/log${opt.raw ? '?format=raw' : ''}`, { headers: { 'x-bounty-actor': ACTOR } });
      process.stdout.write(await res.text());
      return;
    }
    case 'edit': {
      const id = idOf(pos);
      const d = {};
      if (opt.file) Object.assign(d, parseTaskFile(opt.file));
      for (const k of ['title', 'type', 'tier', 'priority', 'project']) if (opt[k]) d[k] = opt[k];
      if (opt.desc) d.description = opt.desc;
      if (opt.brief) d.description = fs.readFileSync(opt.brief, 'utf8');
      if (opt.criteria) d.criteria = list(opt.criteria);
      if (opt.depends) d.depends_on = String(opt.depends).split(',').map(s => Number(s.replace('#', ''))).filter(Boolean);
      delete d.slot; delete d.depends;
      const b = await api('PATCH', `/bounties/${id}`, d);
      console.log(`#${b.id} updated: ${b.title} (${(b.criteria || []).length} criteria)`);
      return;
    }
    case 'assign': {
      const id = idOf(pos); const slot = pos[1];
      if (!slot) die('assign ID SLOT|none');
      const b = await api('POST', `/bounties/${id}/assign`, { slot: slot === 'none' ? null : slot });
      console.log(`#${b.id} assigned to ${b.assignee_slot || 'nobody'} [${b.status}]`);
      return;
    }
    case 'ready': case 'backlog': {
      const ids = pos.length ? pos : [ENV_ID];
      for (const id of ids) { const b = await api('POST', `/bounties/${Number(id)}/${cmd}`, {}); console.log(`#${b.id} -> ${b.status}`); }
      return;
    }
    case 'start': {
      const b = await api('POST', `/bounties/${idOf(pos)}/start`, {});
      console.log(`#${b.id} in_progress. Heartbeat with 'bounty progress "..."', check 'bounty inbox' often; finish with 'bounty submit'.`);
      printNotes(b.unread_notes);
      return;
    }
    case 'progress': {
      const note = pos.join(' ');
      const check = list(opt.check).flatMap(c => String(c).split(',')).map(Number).filter(Boolean);
      const id = ENV_ID ? Number(ENV_ID) : die('progress needs BOUNTY_ID');
      const b = await api('POST', `/bounties/${id}/progress`, { note, check, percent: opt.percent ? Number(opt.percent) : null });
      console.log(`#${b.id} progress noted${check.length ? `; checked ${check.join(',')}` : ''}`);
      printNotes(b.unread_notes);
      return;
    }
    case 'note': {
      const id = /^\d+$/.test(pos[0] || '') ? Number(pos.shift()) : idOf([]);
      const text = pos.join(' ');
      if (!text) die('note ID "text"');
      const e = await api('POST', `/bounties/${id}/notes`, { text });
      console.log(`note #${e.id} on bounty #${id}: the worker sees it on its next 'bounty inbox' / progress, and every later attempt gets it in its prompt`);
      return;
    }
    case 'replies': {
      const notes = await api('GET', `/human-notes${opt.all ? '' : '?unread=1'}`);
      const fresh = notes.filter(n => !n.read).map(n => n.id);
      if (!opt.peek && fresh.length) await api('POST', '/human-notes/read', { ids: fresh });
      if (opt.json) { console.log(JSON.stringify(notes, null, 2)); return; }
      if (!notes.length) { console.log(`no ${opt.all ? '' : 'unread '}messages from the human.`); return; }
      console.log(`${notes.length} message${notes.length > 1 ? 's' : ''} from the human${opt.all ? '' : ' (unread)'}, newest first${opt.peek ? ' (peek; nothing marked read)' : fresh.length ? `; ${fresh.length} marked read` : ''}:`);
      for (const n of notes) console.log(fmtReply(n));
      return;
    }
    case 'inbox': {
      const id = idOf(pos);
      const peek = opt.peek || (!worker && opt.all);
      const notes = opt.all ? await api('GET', `/bounties/${id}/notes`) : peek ? await api('GET', `/bounties/${id}/inbox`) : await api('POST', `/bounties/${id}/inbox`, {});
      if (opt.json) { console.log(JSON.stringify(notes, null, 2)); return; }
      if (!notes.length) { console.log(`#${id}: no ${opt.all ? '' : 'unread '}notes.`); return; }
      if (opt.all) { for (const n of notes) console.log(`[${n.at.slice(0, 16).replace('T', ' ')} ${n.actor}] ${n.read_at ? `(read ${n.read_at.slice(0, 16).replace('T', ' ')} by ${n.read_by})` : '(UNREAD)'} ${n.note}`); return; }
      if (peek) { console.log(`#${id}: ${notes.length} unread note(s) (peek; still unread):`); printNotes(notes, { header: false }); return; }
      printNotes(notes);
      return;
    }
    case 'heartbeat': { await api('POST', `/bounties/${idOf(pos)}/heartbeat`, {}); console.log('ok'); return; }
    case 'block': {
      const id = /^\d+$/.test(pos[0] || '') && !worker ? Number(pos.shift()) : idOf([]);
      const reason = pos.join(' ');
      if (!reason) die('block needs a reason');
      const b = await api('POST', `/bounties/${id}/block`, { reason });
      console.log(`#${b.id} blocked: ${reason}${worker ? '\nYou are done with this bounty: exit now.' : ''}`);
      return;
    }
    case 'split': {
      const id = opt.parent ? Number(opt.parent) : idOf([]);
      const title = pos.join(' ');
      if (!title) die('split "<title>" [--desc TEXT]');
      const b = await api('POST', `/bounties/${id}/split`, { title, description: opt.desc || '', criteria: list(opt.criteria), type: opt.type, tier: opt.tier, priority: opt.priority });
      console.log(`split #${b.id} from #${id}: ${b.title} (backlog; the orchestrator triages it)`);
      return;
    }
    case 'submit': {
      const id = idOf(pos);
      const r = await api('POST', `/bounties/${id}/submit`, { branch: opt.branch });
      console.log(`submitted #${id}: branch ${r.branch}, ${r.commits.length} commit(s), ${r.files} file(s). Verifying: ${r.verify}`);
      if (opt['no-wait']) return;
      const waitMin = Number(opt['wait-min'] || 8);
      const until = Date.now() + waitMin * 60000;
      while (Date.now() < until) {
        await sleep(5000);
        const b = await api('GET', `/bounties/${id}`);
        if (b.ci_status === 'running') continue;
        if (b.status === 'in_progress' && b.ci_status === 'fail') {
          const ev = [...b.events].reverse().find(e => e.kind === 'verify');
          console.log(`VERIFY FAILED. Fix it and submit again.\n${ev ? ev.note : ''}\nFull log: ${b.ci_log}`);
          process.exit(2);
        }
        console.log(`#${id} is now ${b.status}${b.status === 'review' ? ' (verify passed; the reviewer reads your diff next)' : ''}. You are done with this bounty: exit now.`);
        return;
      }
      console.log(`verify is still running after ${waitMin} min. The board finishes it without you: if it fails, the bounty goes back to ready with the log for a fresh worker. You can exit now.`);
      return;
    }
    case 'approve': { const id = idOf(pos); const b = await api('POST', `/bounties/${id}/approve`, { notes: pos.slice(1).join(' ') || null }); console.log(`#${b.id} -> ${b.status}. Merge it into main; the board marks it done when the commits are there.`); return; }
    case 'reject': { const id = idOf(pos); const b = await api('POST', `/bounties/${id}/reject`, { notes: pos.slice(1).join(' ') }); console.log(`#${b.id} -> ${b.status}`); return; }
    case 'fail': { const id = idOf(pos); const b = await api('POST', `/bounties/${id}/fail`, { reason: pos.slice(1).join(' ') }); console.log(`#${b.id} -> ${b.status}`); return; }
    case 'kill': { const id = idOf(pos); const r = await api('POST', `/bounties/${id}/kill`, { reason: pos.slice(1).join(' ') || undefined }); console.log(JSON.stringify(r)); return; }
    case 'done': {
      const id = idOf(pos);
      const r = await api('POST', `/bounties/${id}/done`, {});
      console.log(`#${id} DONE (${r.how}); ${r.credited ? `+$${r.reward} loot to ${r.credited}` : 'no slot credited'}`);
      return;
    }
    case 'close-merged': {
      const id = idOf(pos);
      const commits = list(opt.commit).flatMap(c => String(c).split(',')).map(s => s.trim()).filter(Boolean);
      if (!commits.length || commits.includes('true')) die('close-merged ID --commit SHA [--commit SHA]... ["evidence"]');
      const r = await api('POST', `/bounties/${id}/close-merged`, { commits, evidence: pos.slice(1).join(' ') });
      console.log(`#${id} DONE (close-merged: ${r.commits.map(c => c.slice(0, 10)).join(' ')} on main); ${r.credited ? `+$${r.reward} loot to ${r.credited}` : 'no slot credited (work done off the board)'}`);
      return;
    }
    case 'next': {
      const slot = pos[0] || SLOT;
      if (!slot) die('next [SLOT] (or set BOUNTY_SLOT)');
      const r = await api('GET', `/next?slot=${encodeURIComponent(slot)}`);
      if (!r.next) { console.log(`no ready bounty for ${slot}: idle.${worker ? ' Exit now; the dispatcher spawns a fresh worker when there is work.' : ''}`); return; }
      console.log(`next for ${slot}: #${r.next.id} ${r.next.title}${worker ? '\nDon\'t start it yourself: exit, and the dispatcher spawns a fresh worker for it.' : ''}`);
      return;
    }
    case 'lease': {
      const res = pos[0] || 'gpu';
      const body = { bounty_id: ENV_ID ? Number(ENV_ID) : null, slot: SLOT || null, holder: ENV_ID ? null : (opt.holder || ACTOR), ttl_min: opt.ttl ? Number(opt.ttl) : undefined, note: opt.note };
      const deadline = Date.now() + Number(opt['max-wait'] || 60) * 60000;
      let said = false;
      for (;;) {
        const r = await api('POST', `/leases/${res}`, body);
        if (r.external) {
          const h = r.holder ? Object.entries(r.holder).filter(([k]) => k !== 'file').map(([k, v]) => `${k}=${v}`).join(' ') : '';
          console.log(`'${res}' is ${r.what}.\nIt is ${r.held ? `HELD${h ? ' by ' + h : ''}` : 'FREE'} right now.${r.holder_stale ? ' (stale holder file: ' + h + ')' : ''}\n${r.how}\nScript: ${r.script}\nThe board does not hold this lock for you; take it with the script.`);
          return;
        }
        if (r.granted) { console.log(`lease '${res}' ${r.renewed ? 'renewed' : 'granted'} until ${r.lease.expires_at}. Release it with: bounty release ${res}`); return; }
        if (opt['no-wait']) { console.log(`lease '${res}' is held by ${r.lease.holder} until ${r.lease.expires_at}`); process.exit(3); }
        if (!said) { console.log(`lease '${res}' is held by ${r.lease.holder} (until ${r.lease.expires_at}); waiting...`); said = true; }
        if (Date.now() > deadline) die(`gave up waiting for lease '${res}'`);
        if (ENV_ID) await api('POST', `/bounties/${ENV_ID}/heartbeat`, {});
        await sleep(10000);
      }
    }
    case 'release': {
      const res = pos[0] || 'gpu';
      const r = await api('DELETE', `/leases/${res}`, { bounty_id: ENV_ID ? Number(ENV_ID) : null, holder: ENV_ID ? null : (opt.holder || ACTOR), force: !!opt.force });
      if (r.external) { console.log(`'${res}' is an external lock (${r.script}); release it with the script (or it is released when the locked command exits).`); return; }
      console.log(r.released ? `released '${res}'` : `'${res}' was not held`);
      return;
    }
    case 'pause': case 'resume': { const r = await api('POST', `/${cmd}`, {}); console.log(`dispatcher ${r.paused ? 'PAUSED (running workers finish; nothing new spawns)' : 'running'}`); return; }
    case 'status': case 'state': {
      const s = await api('GET', '/state');
      if (opt.json) { console.log(JSON.stringify(s, null, 2)); return; }
      console.log(`dispatcher ${s.paused ? 'PAUSED' : 'running'} | ${s.running}/${s.cap} workers | stall limit ${s.stall_minutes} min`);
      for (const sl of s.slots) {
        const w = sl.bounty ? `#${sl.bounty.id} ${sl.bounty.title} (since ${sl.attempt?.started_at?.slice(11, 19)}, pid ${sl.attempt?.pid})` : sl.next ? `next: #${sl.next.id} ${sl.next.title}` : '';
        console.log(`  ${sl.id.padEnd(14)} ${sl.state.padEnd(9)} ${String(sl.model || sl.runner).padEnd(7)} ${w}`);
      }
      for (const l of s.leases) {
        if (l.external) console.log(`  lease ${l.resource} (external UE render lock): ${l.held ? 'HELD' + (l.holder ? ' by ' + JSON.stringify(l.holder) : '') : 'free'}`);
        else console.log(`  lease ${l.resource}: ${l.holder} until ${l.expires_at}`);
      }
      const st = s.stats;
      console.log(`  bounties: backlog ${st.backlog} | ready ${st.ready} | in_progress ${st.in_progress} | review ${st.review} | approved ${st.approved} | done ${st.done} | blocked ${st.blocked} | failed ${st.failed} | spent $${st.total_cost_usd || 0}`);
      console.log(`  loot (verified dones only): $${(st.total_loot_earned || 0).toLocaleString()} over ${st.done_credited} credited done | legacy excluded: ${st.legacy_excluded} bounties`);
      return;
    }
    case 'live': {
      if (opt.json) { console.log(JSON.stringify(await api('GET', '/live'), null, 2)); return; }
      const once = async () => {
        const res = await fetch(URL_BASE + '/api/live?format=text', { headers: { 'x-bounty-actor': ACTOR } }).catch(e => die(`cannot reach the board at ${URL_BASE} (${e.cause?.code || e.message})`));
        const text = await res.text();
        if (!res.ok) die(`${res.status}: ${text}`);
        return text;
      };
      if (!opt.watch) { process.stdout.write(await once()); return; }
      const every = Math.max(2, Number(opt.watch === true ? 5 : opt.watch) || 5) * 1000;
      for (;;) { const t = await once(); process.stdout.write('\x1b[2J\x1b[H' + t); await new Promise(r => setTimeout(r, every)); }
    }
    case 'leaderboard': case 'agents': {
      const rows = await api('GET', '/agents/leaderboard');
      if (opt.json) { console.log(JSON.stringify(rows, null, 2)); return; }
      console.log('slot            loot     done  failed  streak  cost');
      for (const a of rows) console.log(`${a.id.padEnd(14)} ${String(a.total_loot).padStart(6)}  ${String(a.missions_completed).padStart(5)}  ${String(a.missions_failed).padStart(6)}  ${String(a.streak).padStart(6)}  $${a.cost_usd.toFixed(2)}`);
      return;
    }
    case 'import': {
      const src = pos[0]; if (!src) { console.error('usage: bounty import <source>'); process.exit(1); }
      const r = await api('POST', `/import/${src}`, {});
      console.log(JSON.stringify(r, null, 2));
      return;
    }
    case 'project': {
      const sub = pos[0] || 'list';
      if (sub === 'list') { for (const p of await api('GET', '/projects')) console.log(`${p.id.padEnd(12)} ${p.repo}  main=${p.main_branch}  wt="${p.worktree_cmd}"  verify="${p.verify_cmd || ''}"`); return; }
      if (sub === 'add') {
        const p = { id: pos[1], repo: opt.repo, main_branch: opt.main, worktree_cmd: opt['wt-cmd'], worktree_path: opt['wt-path'], verify_cmd: opt.verify, name: opt.name };
        if (opt.rules) p.rules = list(opt.rules);
        const r = await api('POST', '/projects', p);
        console.log(`project ${r.id} saved`);
        return;
      }
      die('project list | project add ID --repo PATH ...');
      return;
    }
    default: die(`unknown command '${cmd}'. Try: bounty help`);
  }
}

main().catch(e => die(e.stack || e.message));
