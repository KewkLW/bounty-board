[Unit]
Description=Totally not a Kanban sentinel (read-only health scan of every board)
# No network, no model calls: it only reads board databases and logs, and writes its own out dir.

[Service]
Type=oneshot
# Edit these paths to match your installation (node is looked up on the user manager's PATH):
WorkingDirectory=%h/bounty-board
ExecStart=/usr/bin/env node %h/bounty-board/bin/bounty sentinel
# Defaults: boards from $XDG_STATE_HOME/totally-not-a-kanban/boards, output in
# $XDG_STATE_HOME/bounty-board/sentinel. Override with flags, e.g.:
# ExecStart=/usr/bin/env node %h/bounty-board/bin/bounty sentinel --since 72 --board %h/some-board --out %h/.local/state/bounty-board/sentinel
Nice=10
IOSchedulingClass=idle
StandardOutput=journal
StandardError=journal
