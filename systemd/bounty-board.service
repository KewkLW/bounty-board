[Unit]
Description=Wasteland Bounty Board (task board, dispatcher, reviewer)
After=network-online.target

[Service]
Type=simple
# Edit these paths to match your installation:
WorkingDirectory=%h/bounty-board
ExecStart=node %h/bounty-board/server.js
Environment=NODE_ENV=production
# Uncomment to use a config outside config/board.json:
# Environment=BOUNTY_CONFIG=%h/bounty-board/config/board.json
Restart=on-failure
RestartSec=5
# Workers are spawned detached; a board restart must not kill them (they are re-attached on start).
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
